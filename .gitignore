__pycache__/
*.pyc
*.pyo
.env
.env.*
!.env.*.example
dist/
build/
*.spec
!backend/backend.spec
node_modules/
venv/
backend-dist/
backend-build/
out/
tsconfig.*.tsbuildinfo
dev-err.txt
dev-out.txt

# Game dataset — NOT tracked in this repo. Fetched from the private tli-data repo at build
# time via `npm run fetch:data` (see README "Development setup"). This also covers
# data/builds/, which is local user runtime data.
data/

# OpenWolf and Claude Code — local AI tooling, not for version control
.wolf/
.claude/*
# …except the shared engine-authoring skills (committed so the team/repo gets them)
!.claude/skills/
CLAUDE.md

# docs: keep durable references tracked; handoffs / plans / audit snapshots stay local only
docs/*HANDOFF*.md
docs/*IMPLEMENTATION_PLAN*.md
docs/TOOLTIP_*.md
docs/engine-plan.md
docs/stat-audit*.md
docs/stat-*-review.md
docs/stat-meta-review.csv

# Generated static reference data for the web build (regenerate via backend/tools/export_web_data.py)
web-data/

# Web build output + generated backend bundle (regenerate via npm run build:web)
dist-web/
src/renderer/public/backend-py.zip

# Playwright E2E artifacts (traces, screenshots, error contexts)
test-results/
playwright-report/

# Private dev vault (handoffs, plans, agent notes). Tracked in a SEPARATE private repo, never here.
docs/local/

# Planner draft scratch — authoritative plans are published to <umbrella>/shared/plans/, not here.
plans/


# Mobile audit screenshot sweeps (regenerate via e2e/mobile-audit.mjs)
e2e/mobile-audit*/
e2e/*.png

/*
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  X-Content-Type-Options: nosniff

# Safe to cache hard: the app requests this with a ?v=<content-hash> query (pyodideCompute), so a new
# deploy changes the URL; unchanged deploys hit the cache with no revalidation round-trip.
/backend-py.zip
  Cache-Control: public, max-age=31536000, immutable
